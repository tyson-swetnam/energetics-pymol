      "@type": "Dataset",
      "@id": "https://tyson-swetnam.github.io/energetics-pymol/",
      "dct:conformsTo": {
        "@id": "https://bioschemas.org/profiles/Dataset/1.0-RELEASE"
      },
      "name": "Energetics — The molecules that store a forest's energy",
      "description": "46 reproducible 3D molecular models (PDB with CONECT bonds + ray-traced PNG) of the organic molecules that store chemical-bond energy in a Pinus ponderosa (ponderosa pine, conifer/softwood) forest, built for the manuscript \"Falk, Swetnam & McKenzie — Ecosystems as energy fields (2026)\". Every model is annotated with OBO Foundry ontology terms (ChEBI, GO, ENVO, PO, NCBITaxon).",
      "url": "https://tyson-swetnam.github.io/energetics-pymol/",
      "sameAs": {
        "@id": "https://github.com/tyson-swetnam/energetics-pymol"
      },
      "citation": "Falk, Swetnam & McKenzie — Ecosystems as energy fields (2026)",
      "keywords": [
        "Pinus ponderosa",
        "temperate coniferous forest biome",
        "forest ecosystem",
        "secondary xylem",
        "wood",
        "organic material",
        "photosynthesis",
        "Sugar monomers",
        "Intermediates",
        "Cellulose",
        "Hemicellulose",
        "Lignin",
        "Combustion",
        "Fats",
        "Extractives",
        "Fossil carbon"
      ],
